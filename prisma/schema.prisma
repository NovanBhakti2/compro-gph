generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["companyprofile"]
}

model news {
  id            String      @id @default(uuid()) @db.VarChar(36)
  title         String      @db.VarChar(255)
  slug          String      @unique @db.VarChar(255)
  // Kalimat ringkasan di bawah judul artikel & di kartu berita
  excerpt       String?     @db.VarChar(500)
  content       String
  thumbnail_url String?     @db.VarChar(500)
  status        NewsStatus  @default(DRAFT)

  // Kotak "Key Topics" di samping konten. key_topics: [{ title, description }]
  key_topics_title String? @db.VarChar(255)
  key_topics       Json?

  // Galeri foto di bawah konten. gallery: [{ url, alt }]
  gallery_label    String?  @db.VarChar(100)
  gallery_title    String?  @db.VarChar(255)
  gallery          Json?

  // Indonesian version (shown on /id). Empty fields fall back to the English
  // ones above. Slug, status, date, category, thumbnail and photos are shared.
  title_id            String? @db.VarChar(255)
  excerpt_id          String? @db.VarChar(500)
  content_id          String?
  key_topics_title_id String? @db.VarChar(255)
  key_topics_id       Json?
  gallery_label_id    String? @db.VarChar(100)
  gallery_title_id    String? @db.VarChar(255)

  author_id     String      @db.VarChar(36)
  users         users       @relation(fields: [author_id], references: [id], onDelete: Cascade, map: "fk_news_author")

  category_id   String?     @db.VarChar(36)
  categories    categories? @relation(fields: [category_id], references: [id], onDelete: SetNull, map: "fk_news_category")

  published_at  DateTime?
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt

  @@schema("companyprofile")
}

model categories {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(255)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  news        news[]

  @@schema("companyprofile")
}

model users {
  id         String   @id @default(uuid()) @db.VarChar(36)
  email      String   @unique @db.VarChar(255)
  name       String   @db.VarChar(255)
  password   String   @db.VarChar(255)
  role       Role     @default(USER)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  news       news[]

  @@schema("companyprofile")
}

enum NewsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@schema("companyprofile")
}

enum Role {
  USER
  ADMIN
  EDITOR

  @@schema("companyprofile")
}